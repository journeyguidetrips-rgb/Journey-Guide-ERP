{
  "name": "travel-erp-backend",
  "version": "1.0.0",
  "description": "Express.js backend for Journey Guide ERP system",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts"
  },
  "keywords": [
    "travel",
    "erp",
    "express",
    "typescript"
  ],
  "author": "journeyguidetrips-rgb",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.8",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "docx": "^9.6.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.1",
    "html-to-text": "^9.0.5",
    "jsonwebtoken": "^9.0.2",
    "marked": "^18.0.2",
    "multer": "^2.1.0",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^5.7.284",
    "pg": "^8.11.5",
    "puppeteer": "^24.42.0",
    "sharp": "^0.33.3",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/marked": "^5.0.2",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.12.7",
    "@types/pg": "^8.11.5",
    "@types/uuid": "^10.0.0",
    "concurrently": "^8.2.0",
    "eslint": "^9.1.1",
    "prettier": "^3.2.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.0.0"
  }
}
