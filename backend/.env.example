# Environment
NODE_ENV=development

# Server
PORT=5000

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/travel_erp

# JWT
JWT_SECRET=your-super-secret-key-change-this-in-production

# File Upload
FILE_UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800

# Logging
LOG_DIR=./logs
LOG_LEVEL=info